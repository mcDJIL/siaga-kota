# URL publik backend API (tanpa garis miring di akhir).
VITE_API_BASE_URL=

# Realtime Reverb. Nilainya harus sama dengan REVERB_* di .env backend.
# Saat produksi, VITE_REVERB_HOST adalah domain publik hasil tunnel,
# dan VITE_REVERB_PORT adalah 443 karena diakses lewat HTTPS.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Kunci publik Web Push. Ambil dari VAPID_PUBLIC_KEY di .env backend
# (hasil `php artisan webpush:vapid`). Kunci privat tidak boleh ada di sini.
VITE_VAPID_PUBLIC_KEY=

# Port lokal yang dipublikasikan container di produksi (dipakai compose.prod.yml).
FRONTEND_PORT=25173
