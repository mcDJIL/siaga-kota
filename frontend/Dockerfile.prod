# syntax=docker/dockerfile:1

# ---------- Stage 1: build ----------
FROM node:22-alpine AS build

WORKDIR /app

# npm ci butuh package-lock.json dan lebih deterministik daripada npm install.
COPY package.json package-lock.json ./
RUN npm ci

# Menyalin seluruh source termasuk .env. Vite membaca .env secara native dan
# meng-inline variabel VITE_* ke dalam bundle, sehingga tidak perlu
# mendaftarkan setiap variabel sebagai ARG.
COPY . .
RUN npm run build

# ---------- Stage 2: serve ----------
FROM nginx:1.27-alpine AS runtime

COPY nginx.conf /etc/nginx/conf.d/default.conf

# Hanya hasil build yang disalin. Source dan .env tidak ikut ke image final.
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost/ > /dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
